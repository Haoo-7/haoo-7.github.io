---
import { getCollection } from 'astro:content';
import Base from '../layouts/Base.astro';
import Tray from '../components/Tray.astro';
import Reader from '../components/Reader.astro';
import Hello from '../components/Hello.astro';
import Cat from '../components/Cat.astro';
import TailTip from '../components/TailTip.astro';
import { projects } from '../data/projects';
import { postMeta, readerItem } from '../data/posts';
import { frames } from '../data/frames';
import '../styles/parts.css';
import '../styles/home.css';
import '../styles/cat.css';

const posts = (await getCollection('posts', ({ data }) => !data.draft))
  .sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf())
  .slice(0, 2);
const items = posts.map((post, i) => readerItem(post, i, posts.length));
---
<Base hello={false}>
  <section class="hero">
    <div class="hero-l">
      <h1 class="words" aria-label="Life, Tech and History">
        <ol>
          <li data-i="0"><span class="n">01</span><span class="w">Life,</span></li>
          <li data-i="1" class="on"><span class="n">02</span><span class="w">Tech <em>&amp;</em></span></li>
          <li data-i="2"><span class="n">03</span><span class="w">History.</span></li>
        </ol>
      </h1>
      <p class="intro">I’m Haoo, a history student who builds like an engineer. <span>Trying to make life better with technology.</span></p>
    </div>

    <div class="panel" id="panel" role="button" tabindex="0" aria-label="Show the next photograph">
      <div class="frame">
        <img src="/images/refresh/life.jpg" width="733" height="1100" alt="A paperback, a glass of water and earbuds on a desk by the window" />
        <img src="/images/refresh/tech.jpg" width="733" height="1100" alt="A half-built mechanical keyboard and a bare circuit board on a cutting mat" class="on" fetchpriority="high" />
        <img src="/images/refresh/history.jpg" width="733" height="1100" alt="An open thread-bound book beside a rolled stele rubbing" />
        <div class="flash" aria-hidden="true"></div>
      </div>
      <div class="cap mono">
        <span>Fig. <b id="fig">02</b> <span id="figname">The workbench</span></span>
        <span class="ticks" aria-hidden="true"><i></i><i class="on"></i><i></i></span>
      </div>
    </div>

    <div class="foot mono">
      <Cat />
      <div class="makes">Makes <a href="/work/">Projects</a><a href="/writing/">Essays</a><a href="/writing/">Reviews</a><a href="/writing/">Research</a></div>
      <a class="scrollhint" href="#work"><i aria-hidden="true"></i>Scroll, or keep watching</a>
    </div>
  </section>

  <section class="bench" id="work" aria-labelledby="work-h">
    <div class="head">
      <p class="kick mono"><b>Fig. 04</b> Work</p>
      <h2 class="h2" id="work-h" data-split>On the bench.</h2>
    </div>
    <Tray />
    <div class="bench-r">
      <p class="lede" data-rise>Small tools for problems I actually had. One compartment each. The empty ones are on purpose.</p>
      <ol class="works" data-rows>
        {projects.map((p, i) => (
          <li class:list={{ on: i === 0 }} data-c={String(i)}>
            <span class="n mono">{String(i + 1).padStart(2, '0')} · {p.kind}</span>
            <h3><a href={`/work/#${p.id}`}>{p.name}</a></h3>
            <p>{p.line}</p>
          </li>
        ))}
        <li class="later" data-c="later" tabindex="0">
          <span class="n mono">03–06</span>
          <h3>Next, when I need it.</h3>
        </li>
      </ol>
      <a class="go mono all" href="/work/">All work →</a>
    </div>
  </section>

  <section class="desk" id="writing" aria-labelledby="writing-h">
    <Reader {...items[0]} />
    <div class="veil" aria-hidden="true"></div>
    <div class="desk-c">
      <div class="head">
        <p class="kick mono"><b>Fig. 05</b> Writing</p>
        <h2 class="h2" id="writing-h" data-split>Written down.</h2>
      </div>
      <ol class="posts" data-items={JSON.stringify(items)}>
        {posts.map((post, i) => (
          <li class:list={{ on: i === 0 }} data-p={String(i)}>
            <span class="meta mono">{postMeta(post)}</span>
            <a class="t" href={`/writing/${post.slug}/`}>{post.data.titleEn ?? post.data.title}</a>
          </li>
        ))}
        <li class="later">History research is on its way here.</li>
      </ol>
      <a class="go mono all" href="/writing/">All writing →</a>
    </div>
  </section>

  <section class="about" id="about" aria-labelledby="about-h">
    <div class="about-l">
      <div class="head">
        <p class="kick mono"><b>Fig. 06</b> About</p>
        <h2 class="h2" id="about-h" data-split>One person,<br /><em>three frames.</em></h2>
      </div>
      <ol class="facts" data-facts>
        {frames.map((f, i) => (
          <li class="on" data-f={String(i)}><span class="mono">0{i + 1} {f.name}</span><p>{f.line}</p></li>
        ))}
      </ol>
      <a class="go mono all" href="/about/">More about me →</a>
    </div>
    <div class="stage" aria-hidden="true">
      <div class="frames">
        {[2, 1, 0].map((k) => (
          <div class="strip partial" data-s={String(k)}>
            <img src={`/images/refresh/${frames[k].img}.jpg`} width="733" height="1100" alt="" loading="lazy" decoding="async" />
            <div class="flash"></div>
          </div>
        ))}
      </div>
      <div class="caps mono">
        {frames.map((f, i) => <span>Fig. 0{i + 1}<b> {f.fig}</b></span>)}
      </div>
    </div>
  </section>

  <section class="now" id="now" aria-labelledby="now-h">
    <p class="kick mono" id="now-h"><b>Fig. 07</b> Lately</p>
    <ol class="lately">
      <li><span>Playing with <em>AI</em>, mostly to study faster.</span></li>
      <li><span>Tinkering with software and small hardware.</span></li>
      <li><span>Reading on how people <em>grow</em>.</span></li>
      <li tabindex="0"><span>Brawlhalla, casually.</span><span class="egg mono">Once top 3 in China, Katana ZERO speedruns</span></li>
    </ol>
  </section>

  <Hello fig="08" more={{ label: 'More about me →', href: '/about/#contact' }} />
  <TailTip slot="end" />
</Base>

<script>
  import '../scripts/home';
  import '../scripts/cat';
</script>
