---
import { getCollection } from 'astro:content';
import { skills } from '../data/skills';

const posts = (await getCollection('posts', ({ data }) => !data.draft))
  .sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf());
const previewKeys: Record<string, string> = {
  'ai-assisted-learning': 'ai',
  'kindle-paperwhite-3': 'kindle',
};
---
<!doctype html>
<html lang="zh-CN">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <link rel="icon" href="data:,">
  <meta name="description" content="Haoo。记录数码工具、学习方法与真实使用体验。">
  <title>Haoo — 技术、生活与历史</title>
  <style>
    @font-face{font-family:Satoshi;src:url("/assets/satoshi-medium.woff2") format("woff2");font-weight:500;font-display:swap}
    @font-face{font-family:Satoshi;src:url("/assets/satoshi-bold.woff2") format("woff2");font-weight:700;font-display:swap}
    @font-face{font-family:SourceHanSerif;src:url("/assets/source-han-serif-cn.woff2") format("woff2");font-weight:400 700;font-display:swap}
    :root{--paper:#FCFCFC;--ink:#181818;--accent:#2456D6;--claude-orange:#D97757;--muted:#626262;--line:#d4d4d4;--gutter:64px;--body:18px;--small:14px;--display:108px;--serif:SourceHanSerif,"Songti SC","STSong",serif;--sans:Satoshi,"Noto Sans CJK SC","Hiragino Sans GB",Arial,sans-serif;--ease:cubic-bezier(.16,1,.3,1)}
    *{box-sizing:border-box;letter-spacing:0}
    html{scroll-behavior:smooth;scroll-padding-top:100px;overflow-x:hidden}
    body{margin:0;background:var(--paper);color:var(--ink);font:500 var(--body)/1.75 var(--sans);overflow-x:hidden}
    ::selection{background:var(--accent);color:var(--paper)}
    a{color:inherit;text-decoration:none}
    .keep{white-space:nowrap}
    button{font:inherit;color:inherit;background:none;border:0;padding:0;cursor:pointer}
    a:focus-visible,button:focus-visible{outline:2px solid var(--accent);outline-offset:6px}
    [x-cloak]{display:none!important}
    .nav{position:fixed;inset:0 0 auto;z-index:30;height:84px;padding:0 var(--gutter);display:flex;align-items:center;justify-content:space-between;background:var(--paper);border-bottom:1px solid transparent;
      .identity{font-size:14px}
      .links{display:flex;gap:32px;font-size:16px}
      a{padding:12px 0;transition:color .2s}
      a:hover{color:var(--accent)}
      .dock{position:absolute;left:var(--gutter);top:25px;width:84px;height:34px;pointer-events:none}
    }
    .opening{position:relative;height:calc(100svh - 176px);min-height:540px;max-height:850px;margin-top:84px}
    .wordmark{--brand-width:min(calc(100% - 2*var(--gutter)),1440px,calc((100svh - 340px)*2.2));position:absolute;left:calc((100% - var(--brand-width))/2);top:20%;width:var(--brand-width);margin:0;line-height:1.13;font-weight:700;transform-origin:0 0;z-index:40;pointer-events:none;
      .solid{display:block;white-space:nowrap}
      .solid span{color:var(--accent)}
      canvas{position:absolute;inset:0;width:100%;height:100%;opacity:0;pointer-events:auto}
      &[data-rendered=true]{.solid{opacity:0}canvas{opacity:1}}
    }
    .topic{position:absolute;font:600 58px/1.1 var(--serif);z-index:2;pointer-events:none}
    .tech{top:7%;left:17%;transform:rotate(-8deg)}
    .history{top:9%;right:12%;transform:rotate(5deg);font-size:64px;color:var(--claude-orange)}
    .life{bottom:9%;left:30%;color:var(--accent);font-size:72px;transform:rotate(-5deg)}
    .identity-copy{position:absolute;left:var(--gutter);bottom:36px;max-width:380px;margin:0;font-size:18px;line-height:1.6}
    .hero-action{position:absolute;bottom:44px;right:var(--gutter);display:flex;align-items:center;gap:28px;font-size:16px;
      img{width:32px;height:32px;transition:transform .3s var(--ease)}
      &:hover img{transform:translateY(6px)}
    }
    .directory{padding:0 var(--gutter);scroll-margin-top:94px}
    .directory-row{border-top:1px solid var(--line)}
    .directory-button{position:relative;isolation:isolate;display:grid;grid-template-columns:70px 1fr auto;align-items:center;min-height:214px;width:100%;text-align:left;transition:color .22s,transform .18s;
      &::before{content:"";position:absolute;inset:0 calc(-1 * var(--gutter));z-index:-1;background:var(--ink);transform:scaleY(0);transform-origin:bottom;transition:transform .38s var(--ease)}
      .number{align-self:start;padding-top:38px;font:500 var(--small)/1.5 Satoshi; color:var(--muted)}
      .title{font:600 var(--display)/1.18 var(--serif);transition:transform .4s var(--ease);text-wrap:balance}
      .label{display:inline-block;position:relative;white-space:nowrap;line-height:1.05}
      .label-text{display:block}
      .label canvas{position:absolute;inset:0;width:100%;height:100%;pointer-events:none}
      .caption{display:block;font:500 16px/1.5 Satoshi;color:var(--muted);margin-top:12px}
      .row-arrow{width:38px;height:38px;transition:transform .3s var(--ease)}
      &.is-engaged,&:focus-visible{color:var(--paper);&::before{transform:scaleY(1)}.number,.caption{color:#d6d6d6}.title{transform:translateX(8px)}.row-arrow{filter:invert(1);transform:translateY(5px)}}
      &:active{transform:scale(.99)}
      &[aria-expanded=true]{.row-arrow{transform:rotate(180deg)}}
    }
    .expanded{display:grid;grid-template-rows:0fr;visibility:hidden;transition:grid-template-rows .38s var(--ease),visibility .38s;
      &.is-open{grid-template-rows:1fr;visibility:visible}
      >.panel-inner{min-height:0;overflow:hidden}
    }
    .panel-pad{padding:8px 0 40px 70px}
    .work-group{display:grid;grid-template-columns:168px minmax(0,1fr);gap:32px;border-top:1px solid var(--line)}
    .work-group+.work-group{margin-top:24px}
    .work-group-title{margin:0;padding-top:32px;font:500 24px/1.5 var(--serif)}
    .work-group-entries{min-width:0}
    .work-group .entry:first-child{border-top:0}
    .work-group .entry h4{font:700 36px/1.2 var(--sans);margin:0 0 12px;overflow-wrap:anywhere}
    .work-group .entry-link:hover h4,.work-group .entry-link:focus-visible h4{color:var(--accent)}
    .work-group .entry-meta{margin-bottom:12px}
    .work-group .entry-link{min-width:0;padding-right:40px}
    .skill-entry .entry-meta{overflow-wrap:anywhere}
      .entry{position:relative;display:grid;grid-template-columns:1fr auto;gap:24px;align-items:start;padding:32px 0;border-top:1px solid var(--line);
      h3{font:500 38px/1.45 var(--serif);margin:0 0 12px;text-wrap:balance}
      &.project-entry h3{font:700 36px/1.2 var(--sans)}
      p{margin:0;color:var(--muted);font-size:17px;max-width:560px;text-wrap:pretty;line-break:strict}
      .entry-link{display:block;padding-right:16px}
      .entry-link:hover h3,.entry-link:focus-visible h3{color:var(--accent)}
      .entry-link:hover .external-arrow{transform:translate(3px,-3px)}
      .article-link .external-arrow{transform:rotate(45deg)}
      .article-link:hover .external-arrow{transform:rotate(45deg) translate(3px,-3px)}
      .external-arrow{position:absolute;right:0;top:38px;width:28px;height:28px;transition:transform .25s var(--ease)}
      .entry-meta{font-size:14px;display:flex;gap:20px;margin:0 0 16px;color:var(--muted)}
      .publication{display:flex;gap:20px}
      .preview-toggle{display:none;min-width:44px;min-height:44px;margin-top:28px;align-items:center;justify-content:center}
      .preview-toggle img{width:24px;height:24px;transition:transform .3s var(--ease)}
      .preview-toggle[aria-expanded=true] img{transform:rotate(180deg)}
      .inline-preview{grid-column:1/-1;margin:0}
      .inline-preview img{display:block;width:100%;height:auto;max-height:360px;object-fit:contain;aspect-ratio:1.55;background:#f0f0f0}
      .site-note{grid-column:1/-1;max-width:650px;padding-top:12px}
      .site-note p{font-size:18px;line-height:1.65}
    }
    .about-text{max-width:760px;font:500 38px/1.55 var(--serif);margin:16px 0 32px;text-wrap:pretty}
    .social-list{display:flex;flex-wrap:wrap;gap:16px 40px;font-size:16px;
      a{display:inline-flex;align-items:center;gap:10px;padding:8px 0}
      img{width:18px;height:18px}
      a:hover{color:var(--accent)}
    }
    .contact{padding:48px 0 52px;border-top:1px solid var(--line);display:flex;align-items:center;justify-content:space-between;gap:40px}
    .email{font-size:24px;overflow-wrap:anywhere}
    .email:hover{color:var(--accent)}
    .footer{margin:0 var(--gutter);padding:0 0 40px;font-size:14px;color:var(--muted)}
    .footer-bottom{display:flex;justify-content:space-between;gap:24px;align-items:center}
    .footer-bottom a{padding:12px 0}
    .footer-bottom a:hover{color:var(--accent)}
    .skip-link{position:fixed;left:24px;top:12px;z-index:100;padding:12px;background:var(--ink);color:var(--paper);transform:translateY(-150%)}
    .skip-link:focus{transform:none}
    .peek{position:fixed;left:0;top:0;width:340px;z-index:50;pointer-events:none;opacity:0;visibility:hidden}
    .peek-sheet{padding:12px;background:var(--paper);box-shadow:0 2px 5px #18181816,0 24px 50px #18181824;transform:scale(.88) rotate(-5deg);
      img{display:block;width:100%;height:210px;object-fit:contain;background:#f0f0f0}
      p{font:500 22px/1.2 var(--serif);margin:16px 4px 8px}
    }
    @media(min-width:1500px){:root{--gutter:88px;--display:128px}.directory-button{min-height:240px}}
    @media(max-width:760px){
      :root{--gutter:24px;--display:60px;--body:16px}
      .nav{height:72px;.identity{font-size:13px}.links{gap:22px;font-size:14px}.dock{top:22px}}
      .opening{height:calc(100svh - 144px);min-height:560px;margin-top:72px}
      .wordmark{--brand-width:calc(100% - 2*var(--gutter));top:30%}
      .tech{top:12%;left:13%;font-size:38px}.history{top:20%;right:12%;font-size:40px}.life{left:48%;bottom:31%;font-size:48px}
      .identity-copy{bottom:80px;font-size:16px;max-width:280px}
      .hero-action{left:var(--gutter);right:auto;bottom:22px;font-size:14px;gap:24px;img{width:24px;height:24px}}
      .directory-button{grid-template-columns:32px 1fr 26px;min-height:162px;.number{padding-top:28px;font-size:13px}.row-arrow{width:26px;height:26px}.caption{font-size:14px;margin-top:8px}}
      .directory-button.is-engaged .title,.directory-button:focus-visible .title{transform:none}
      .panel-pad{padding-left:32px}
      .work-group{grid-template-columns:minmax(0,1fr);gap:0}
      .work-group+.work-group{margin-top:24px}
      .work-group-title{font-size:22px;padding:20px 0 4px}
      .work-group .entry h4{font-size:28px;line-height:1.3}
      .work-group .entry-link{padding-right:0}
      .entry{grid-template-columns:1fr 44px;gap:16px;padding:24px 0;h3{font-size:29px}&.project-entry h3{font-size:28px}p{font-size:16px}.entry-meta{display:block;margin-bottom:12px}.publication{gap:12px;margin-top:4px;flex-wrap:wrap}.external-arrow{display:none}.entry-link{padding:0}.preview-toggle{display:flex;margin-top:68px}.inline-preview img{max-height:none}}
      .entry.project-entry .preview-toggle,.entry.skill-entry .preview-toggle{margin-top:28px}
      .about-text{font-size:28px;line-height:1.5}.social-list{gap:12px 24px;overflow-wrap:anywhere}
      .footer{font-size:13px}.contact{align-items:start;flex-direction:column;gap:24px;padding:32px 0}.email{font-size:20px}
      .peek{display:none}
    }
    @media(max-width:360px){:root{--gutter:20px;--display:46px}.opening{min-height:530px}.history{font-size:36px;right:8%}.directory-button{min-height:150px}.nav .links{gap:16px}.entry h3{font-size:26px}.panel-pad{padding-left:0}}
    @media(prefers-reduced-motion:reduce){.nav .dock::after{content:"Haoo.";font:700 28px/34px Satoshi}.nav .identity{visibility:hidden}}
    @media(prefers-reduced-motion:reduce){html{scroll-behavior:auto}*,*::before,*::after{transition:none!important;animation:none!important}}
    html[data-motion=reduce]{scroll-behavior:auto}
    html[data-motion=reduce] *{transition:none!important}
  </style>
  <script is:inline src="/vendor/gsap.min.js"></script>
  <script is:inline src="/vendor/ScrollTrigger.min.js"></script>
  <script is:inline defer src="/vendor/homepage-brand.js"></script>
  <script is:inline defer src="/vendor/directory-material.js"></script>
  <script is:inline defer src="/vendor/homepage-motion.js"></script>
  <script is:inline defer src="/vendor/alpine.min.js"></script>
  <noscript><style>.directory .directory-row .expanded{grid-template-rows:1fr;visibility:visible}.inline-preview{display:none!important}.site-note[x-cloak]{display:block!important}.peek{display:none}</style></noscript>
</head>
<body x-data="{ open: new URLSearchParams(location.search).get('state') || '', preview: '', blogNote: false, toggle(name) { this.open = this.open === name ? '' : name; this.preview = ''; }, enter(name) { this.open = name; this.$nextTick(() => { window.ScrollTrigger?.refresh(); document.getElementById(name).scrollIntoView({ behavior: document.documentElement.dataset.motion === 'reduce' ? 'auto' : 'smooth' }); }); } }" x-effect="open; preview; blogNote; $nextTick(() => window.ScrollTrigger?.refresh())" @keydown.escape.window="open = ''; preview = ''; blogNote = false" @transitionend.window="if ($event.propertyName === 'grid-template-rows') window.ScrollTrigger?.refresh()">
  <a class="skip-link" href="#directory">跳到目录</a>
  <nav class="nav" aria-label="主导航"><span class="identity">A personal corner of the internet</span><span class="dock" aria-hidden="true"></span><div class="links"><a href="#work" @click.prevent="enter('work')">探索</a><a href="#about" @click.prevent="enter('about')">关于</a></div></nav>
  <header class="opening" id="top">
    <span class="topic tech">Tech</span><span class="topic history">History</span><span class="topic life">Life</span>
    <h1 class="wordmark" aria-label="Haoo"><span class="solid" aria-hidden="true">Haoo<span>.</span></span><canvas aria-hidden="true"></canvas></h1>
    <p class="identity-copy">人文社科学生。<br>写数码，也写学习。<br>做让日常更顺手的工具。</p>
    <a class="hero-action" href="#work" @click.prevent="enter('work')"><span>作品与文章</span><img src="assets/arrow-down.svg" alt=""></a>
  </header>
  <main class="directory" id="directory">
    <section class="directory-row" id="work">
      <h2 style="margin:0"><button class="directory-button work-row" @click="toggle('work')" :aria-expanded="open === 'work'" aria-controls="work-content"><span class="number">01</span><span class="title"><span class="label"><span class="label-text">作品</span><canvas aria-hidden="true"></canvas></span><span class="caption">2 个项目 · {skills.length} 个 Skills</span></span><img class="row-arrow" src="assets/arrow-down.svg" alt=""></button></h2>
      <div class="expanded" id="work-content" :class="{ 'is-open': open === 'work' }" :inert="open !== 'work'" :aria-hidden="open === 'work' ? 'false' : 'true'"><div class="panel-inner"><div class="panel-pad">
        <section class="work-group" aria-labelledby="projects-heading">
        <h3 class="work-group-title" id="projects-heading">项目</h3>
        <div class="work-group-entries">
        <article class="entry project-entry">
          <a class="entry-link" data-peek="dayline" href="https://github.com/Haoo-7/Obsidian-Dayline" target="_blank" rel="noopener noreferrer"><span class="entry-meta">Obsidian 插件</span><h4>Dayline Journal</h4><p>一个把每日笔记变成日历和时间线的工具。</p><img class="external-arrow" src="assets/arrow-up-right.svg" alt=""></a>
          <button class="preview-toggle" aria-label="预览 Dayline Journal" :aria-expanded="preview === 'dayline'" aria-controls="dayline-preview" @click="preview = preview === 'dayline' ? '' : 'dayline'"><img src="assets/arrow-down.svg" alt=""></button>
          <figure class="inline-preview" id="dayline-preview" x-cloak x-show="preview === 'dayline'" x-transition.opacity.duration.220ms><img src="/images/projects/dayline-journal.webp" alt="Dayline Journal 的编辑印刷头图，包含日历、日记与时间线" width="1536" height="1024"></figure>
        </article>
        <article class="entry project-entry">
          <a class="entry-link blog-link" data-peek="blog" href="#blog-note" @click.prevent="blogNote = !blogNote" :aria-expanded="blogNote" aria-controls="blog-note"><span class="entry-meta">个人网站</span><h4>Haoo Blog</h4><p>写数码、学习与历史，也放自己做的东西。</p><img class="external-arrow" src="assets/arrow-down.svg" alt=""></a>
          <button class="preview-toggle" aria-label="预览 Haoo Blog" :aria-expanded="preview === 'blog'" aria-controls="blog-preview" @click="preview = preview === 'blog' ? '' : 'blog'"><img src="assets/arrow-down.svg" alt=""></button>
          <figure class="inline-preview" id="blog-preview" x-cloak x-show="preview === 'blog'" x-transition.opacity.duration.220ms><img src="/images/projects/haoo-blog.webp" alt="Haoo Blog 的字符构成编辑印刷头图" width="1536" height="1024"></figure>
          <div class="site-note" id="blog-note" x-cloak x-show="blogNote" x-transition.opacity.duration.220ms><p>你已经在这里了。一个用来记录、制作和连接技术与人文的个人角落。</p></div>
        </article>
        </div>
        </section>
        <section class="work-group" aria-labelledby="skills-heading">
          <h3 class="work-group-title" id="skills-heading">Skills</h3>
          <div class="work-group-entries">
            {skills.map((skill) => (
              <article class="entry skill-entry">
                <a class="entry-link" data-peek={skill.id} data-peek-src={skill.cover} data-peek-title={skill.name} href={skill.href} target="_blank" rel="noopener noreferrer">
                  <span class="entry-meta">{skill.meta}</span>
                  <h4>{skill.name}</h4>
                  <p>{skill.description}</p>
                  <img class="external-arrow" src="/assets/arrow-up-right.svg" alt="" />
                </a>
                <button class="preview-toggle" aria-label={`预览 ${skill.name}`} aria-controls={`${skill.id}-preview`} x-bind:aria-expanded={`preview === '${skill.id}'`} x-on:click={`preview = preview === '${skill.id}' ? '' : '${skill.id}'`}><img src="/assets/arrow-down.svg" alt="" /></button>
                <figure class="inline-preview" id={`${skill.id}-preview`} x-cloak x-show={`preview === '${skill.id}'`} x-transition.opacity.duration.220ms><img src={skill.cover} alt={skill.coverAlt} width="1536" height="1024" loading="lazy" /></figure>
              </article>
            ))}
          </div>
        </section>
      </div></div></div>
    </section>
    <section class="directory-row" id="writing">
      <h2 style="margin:0"><button class="directory-button writing-row" data-peek="ai" @click="toggle('writing')" :aria-expanded="open === 'writing'" aria-controls="writing-content"><span class="number">02</span><span class="title"><span class="label"><span class="label-text">文章</span><canvas aria-hidden="true"></canvas></span></span><img class="row-arrow" src="assets/arrow-down.svg" alt=""></button></h2>
      <div class="expanded" id="writing-content" :class="{ 'is-open': open === 'writing' }" :inert="open !== 'writing'" :aria-hidden="open === 'writing' ? 'false' : 'true'"><div class="panel-inner"><div class="panel-pad">
        {posts.map((post) => {
          const key = previewKeys[post.slug];
          return (
            <article class="entry">
              <a class="entry-link article-link" data-peek={key} href={`/posts/${post.slug}/`}>
                <span class="entry-meta"><span>{post.data.tags.slice(0, 2).join(' / ')}</span><time datetime={post.data.pubDate.toISOString().slice(0, 10)}>{post.data.pubDate.toISOString().slice(0, 10).replaceAll('-', '.')}</time></span>
                <h3>{post.slug === 'ai-assisted-learning' ? <>告别纸笔，<wbr /><span class="keep">用 AI 辅助学习</span></> : post.slug === 'kindle-paperwhite-3' ? <><span class="keep">高中生为什么</span><wbr /><span class="keep">用 Kindle？</span></> : post.data.title}</h3>
                <p>{post.data.description}</p>
                <img class="external-arrow" src="/assets/arrow-up-right.svg" alt="" />
              </a>
              <button class="preview-toggle" aria-label={`预览：${post.data.title}`} aria-controls={`${post.slug}-preview`} x-bind:aria-expanded={`preview === '${post.slug}'`} x-on:click={`preview = preview === '${post.slug}' ? '' : '${post.slug}'`}><img src="/assets/arrow-down.svg" alt="" /></button>
              <figure class="inline-preview" id={`${post.slug}-preview`} x-cloak x-show={`preview === '${post.slug}'`} x-transition.opacity.duration.220ms><img src={post.data.cover} alt={post.data.title} width="1536" height="1024" loading="lazy" /></figure>
            </article>
          );
        })}
      </div></div></div>
    </section>
    <section class="directory-row" id="about">
      <h2 style="margin:0"><button class="directory-button about-row" @click="toggle('about')" :aria-expanded="open === 'about'" aria-controls="about-content"><span class="number">03</span><span class="title"><span class="label"><span class="label-text">关于</span><canvas aria-hidden="true"></canvas></span></span><img class="row-arrow" src="assets/arrow-down.svg" alt=""></button></h2>
        <div class="expanded" id="about-content" :class="{ 'is-open': open === 'about' }" :inert="open !== 'about'" :aria-hidden="open === 'about' ? 'false' : 'true'"><div class="panel-inner"><div class="panel-pad"><p class="about-text">写正在用的<span class="keep">工具，</span>也常常回到<span class="keep">历史。</span></p></div></div></div>
    </section>
  </main>
  <footer class="footer">
    <div class="contact"><a class="email" href="mailto:re11.zhou@gmail.com">re11.zhou@gmail.com</a><div class="social-list"><a href="https://github.com/Haoo-7" target="_blank" rel="noopener noreferrer">GitHub<img src="assets/arrow-up-right.svg" alt=""></a><a href="https://sspai.com/u/6veuyub4/updates" target="_blank" rel="noopener noreferrer">少数派<img src="assets/arrow-up-right.svg" alt=""></a><a href="https://space.bilibili.com/438365760" target="_blank" rel="noopener noreferrer">哔哩哔哩<img src="assets/arrow-up-right.svg" alt=""></a></div></div>
