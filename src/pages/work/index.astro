---
import Base from '../../layouts/Base.astro';
import Tray from '../../components/Tray.astro';
import { projects } from '../../data/projects';
import { siteConfig } from '../../data/site';
const github = siteConfig.socialLinks.find((l) => l.label === 'GitHub')!;
import '../../styles/parts.css';
import '../../styles/pages.css';
---
<Base title="Work" description="Small tools built for real problems: what each one solves, how it works and where to get it." active="/work/">
  <header class="p-head">
    <p class="kick mono"><b>Work</b><span>{projects.length} projects · {6 - projects.length} empty compartments</span></p>
    <h1 class="p-h1" data-split>On the bench.</h1>
    <p class="p-lede" data-rise>Small tools for problems I actually had. Each one gets a compartment, and the empty ones are on purpose: they fill when I need the next tool.</p>
  </header>

  <div class="work">
    <div class="work-tray">
      <Tray class="tray-zoom" />
      <p class="work-cap mono" aria-hidden="true">Fig. 04 The cutting mat, from above</p>
    </div>

    <ol class="dossiers" data-rows>
      {projects.map((p, i) => (
        <li class="dossier" id={p.id} data-c={String(i)}>
          <p class="d-n mono"><b>{String(i + 1).padStart(2, '0')}</b><span>{p.kind}</span><span>Since {p.started}</span></p>
          <h2 class="d-name">{p.name}</h2>
          <p class="d-line">{p.line}</p>
          <dl class="d-facts">
            <div><dt class="mono">Why</dt><dd>{p.problem}</dd></div>
            <div><dt class="mono">What it does</dt><dd><ul>{p.does.map((d) => <li>{d}</li>)}</ul></dd></div>
            <div><dt class="mono">Built with</dt><dd>{p.stack}</dd></div>
            <div><dt class="mono">Status</dt><dd>{p.status}</dd></div>
          </dl>
          <a class="go mono" href={p.href} rel="noopener" target="_blank">Source on GitHub ↗</a>
        </li>
      ))}
      <li class="dossier later" data-c="later" tabindex="0">
        <p class="d-n mono"><b>03–06</b><span>Empty</span></p>
        <h2 class="d-name">Next, when I need it.</h2>
        <p class="d-line">Whatever I build next goes here. The rest of my repositories live on <a href={github.href} rel="me noopener">GitHub</a>.</p>
      </li>
    </ol>
  </div>
</Base>

<script>
  import '../../scripts/work';
</script>
