---
import { getCollection, render, type CollectionEntry } from 'astro:content';

export async function getStaticPaths() {
  const posts = (await getCollection('posts', ({ data }) => !data.draft))
    .sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf());

  return posts.map((post) => ({
    params: { slug: post.slug },
    props: { post, related: posts.find((candidate) => candidate.id !== post.id) },
  }));
}

interface Props {
  post: CollectionEntry<'posts'>;
  related?: CollectionEntry<'posts'>;
}
const { post, related } = Astro.props;
const { Content, headings } = await render(post);
const chapters = headings.filter((heading) => heading.depth === 2 && heading.slug !== 'footnote-label');
const { title, description, pubDate, tags, cover, externalPublications } = post.data;
const canonical = new URL(`/posts/${post.slug}/`, Astro.site);
const readingMinutes = Math.max(1, Math.ceil((post.body ?? '').replace(/<[^>]*>/g, '').length / 450));
const dateLabel = pubDate.toLocaleDateString('zh-CN', {
  year: 'numeric',
  month: '2-digit',
  day: '2-digit',
});
---
<!doctype html>
<html lang="zh-CN">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <meta property="og:type" content="article" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={new URL(cover, Astro.site)} />
    <meta property="og:url" content={canonical} />
    <link rel="icon" href="data:," />
    <title>{title} — Haoo</title>
    <style>
      @font-face{font-family:Satoshi;src:url("/assets/satoshi-medium.woff2") format("woff2");font-weight:500;font-display:swap}
      @font-face{font-family:Satoshi;src:url("/assets/satoshi-bold.woff2") format("woff2");font-weight:700;font-display:swap}
      @font-face{font-family:SourceHanSerif;src:url("/assets/source-han-serif-cn.woff2") format("woff2");font-weight:400 700;font-display:swap}
      :root{--paper:#fcfcfc;--ink:#181818;--accent:#2456d6;--muted:#626262;--line:#d4d4d4;--gutter:64px;--sans:Satoshi,"Noto Sans CJK SC","Hiragino Sans GB",Arial,sans-serif;--serif:SourceHanSerif,"Songti SC","STSong",serif;--ease:cubic-bezier(.16,1,.3,1)}
      *{box-sizing:border-box;letter-spacing:0}
      html{scroll-behavior:smooth;scroll-padding-top:110px}
      body{margin:0;background:var(--paper);color:var(--ink);font:500 17px/1.8 var(--sans);overflow-x:hidden}
      ::selection{background:var(--accent);color:var(--paper)}
      a{color:inherit;text-decoration:none}
      a:focus-visible{outline:2px solid var(--accent);outline-offset:6px}
      .skip-link{position:fixed;left:24px;top:12px;z-index:100;padding:10px 12px;background:var(--ink);color:var(--paper);transform:translateY(-150%)}
      .skip-link:focus{transform:none}
      .nav{position:sticky;top:0;z-index:20;height:84px;padding:0 var(--gutter);display:flex;align-items:center;justify-content:space-between;background:var(--paper);border-bottom:1px solid var(--line)}
      .identity{font:700 28px/1 var(--sans)}
      .identity span{color:var(--accent)}
      .nav-links{display:flex;gap:32px;font-size:16px}
      .nav-links a{padding:12px 0;transition:color .2s}
      .nav-links a:hover{color:var(--accent)}
      .article-shell{width:min(calc(100% - 2 * var(--gutter)),1120px);margin:0 auto;padding:56px 0 88px}
      .article-header{max-width:900px;padding-bottom:36px;border-bottom:1px solid var(--line)}
      .back-link{display:inline-flex;align-items:center;gap:10px;margin-bottom:32px;color:var(--muted);font-size:14px;transition:color .2s}
      .back-link:hover{color:var(--accent)}
      .back-link img{width:18px;height:18px;transform:rotate(90deg);transition:transform .24s var(--ease)}
      .back-link:hover img{transform:rotate(90deg) translateY(4px)}
      a:active{opacity:.65}
      .article-meta{display:flex;flex-wrap:wrap;gap:12px 24px;align-items:center;margin-bottom:22px;color:var(--muted);font-size:14px}
      .article-tags{display:flex;flex-wrap:wrap;gap:8px}
      .article-tags span{color:var(--accent)}
      .article-title{max-width:900px;margin:0;font:500 46px/1.4 var(--serif);text-wrap:balance;overflow-wrap:anywhere}
      .keep,.article-body :global(.keep){white-space:nowrap}
      :global(astro-dev-toolbar){display:none}
      .article-description{max-width:720px;margin:24px 0 0;color:var(--muted);font-size:18px;line-height:1.8}
      .reading-layout{display:grid;grid-template-columns: minmax(0,720px) minmax(180px,1fr);gap:64px;margin-top:44px;align-items:start}
      .article-body{min-width:0;font-family:var(--serif);font-size:19px;line-height:1.95;line-break:strict;overflow-wrap:anywhere}
      .article-body :global(>:first-child){margin-top:0}
      .toc{position:sticky;top:124px;font-size:14px;max-height:calc(100svh - 150px);overflow:auto}
      .toc summary{list-style:none;font-size:14px;color:var(--muted);padding:0 0 14px}
      .toc summary::-webkit-details-marker{display:none}
      .toc summary img{display:none;width:18px;height:18px;transition:transform .24s var(--ease)}
      .toc ol{list-style:none;counter-reset:chapter;margin:0;padding:0;border-top:1px solid var(--line)}
      .toc li{counter-increment:chapter}
      .toc a{display:grid;grid-template-columns:22px 1fr;gap:8px;padding:11px 0;line-height:1.65;transition:color .2s}
      .toc a::before{content:counter(chapter,decimal-leading-zero);font-size:12px;color:var(--muted)}
      .toc a:hover{color:var(--accent)}
      .article-body :global(h2){margin:72px 0 20px;font:600 34px/1.35 var(--serif);text-wrap:balance}
      .article-body :global(h3){margin:48px 0 14px;font:600 26px/1.45 var(--serif);text-wrap:balance}
      .article-body :global(h4){margin:36px 0 14px;font:600 21px/1.6 var(--serif)}
      .article-body :global(p){margin:0 0 24px}
      .article-body :global(ul),.article-body :global(ol){margin:0 0 28px;padding-left:1.4em}
      .article-body :global(li){padding-left:4px;margin:6px 0}
      .article-body :global(a){color:var(--accent);text-decoration:underline;text-decoration-thickness:1px;text-underline-offset:4px}
      .article-body :global(strong){font-weight:700}
      .article-body :global(blockquote){margin:36px 0;padding:24px 0;border-block:1px solid var(--line);color:var(--muted);font-size:20px}
      .article-body :global(blockquote p:last-child){margin-bottom:0}
      .article-body :global(.article-figure){margin:44px 0}
      .article-body :global(.article-figure img){display:block;width:100%;height:auto;max-height:820px;object-fit:contain;background:#f1f1f1}
      .article-body :global(.article-figure--compact){max-width:560px;margin-left:auto;margin-right:auto}
      .article-body :global(figcaption){margin-top:10px;color:var(--muted);font:500 13px/1.6 var(--sans)}
      .article-body :global(code){padding:2px 5px;background:#f0f0f0;font-family:ui-monospace,SFMono-Regular,Menlo,monospace;font-size:.82em}
      .article-body :global(pre){overflow:auto;margin:32px 0;padding:20px;background:#f0f0f0;font:14px/1.6 ui-monospace,SFMono-Regular,Menlo,monospace}
      .article-body :global(.footnotes){margin-top:48px;font:500 15px/1.8 var(--sans)}
      .article-body :global(.sr-only){position:absolute;width:1px;height:1px;padding:0;margin:-1px;overflow:hidden;clip:rect(0,0,0,0);white-space:nowrap;border:0}
      .article-body :global([data-footnote-ref]){display:inline-flex;align-items:center;justify-content:center;min-width:1.35em;height:1.35em;margin:0 .08em;padding:0 .18em;border:0;border-radius:999px;background:transparent;color:var(--accent);font:700 .72em/1 var(--sans);text-decoration:none;vertical-align:super;transition:background .18s var(--ease),color .18s var(--ease)}
      .article-body :global([data-footnote-ref]:hover),.article-body :global([data-footnote-ref][aria-expanded=true]){background:var(--accent);color:var(--paper)}
      :global(.footnote-popover){position:fixed;z-index:60;width:min(380px,calc(100vw - 32px));padding:16px 18px;background:var(--paper);border:1px solid var(--line);box-shadow:0 12px 34px #1818181c;color:var(--ink);font:500 15px/1.7 var(--sans);opacity:0;transform:translateY(5px);transition:opacity .18s var(--ease),transform .18s var(--ease)}
      :global(.footnote-popover.is-open){opacity:1;transform:translateY(0)}
      :global(.footnote-popover p){margin:0}
      :global(.footnote-popover .data-footnote-backref){display:none}
      :global(.footnote-popover a){color:var(--accent);text-decoration:underline;text-underline-offset:3px}
      :global(.footnote-popover-close){position:absolute;top:8px;right:10px;width:28px;height:28px;color:var(--muted);font:500 20px/1 var(--sans)}
      :global(.footnote-popover-close:hover){color:var(--ink)}
      :global(.footnote-popover-content){padding-right:18px}
      .article-body :global(table){display:block;max-width:100%;overflow:auto;border-collapse:collapse;font-size:16px}
      .article-body :global(th),.article-body :global(td){padding:12px;border-bottom:1px solid var(--line);text-align:left}
      .article-footer{max-width:720px;margin:72px 0 0;padding-top:28px;border-top:1px solid var(--line)}
      .related{display:block;margin-top:36px;padding-top:28px;border-top:1px solid var(--line)}
      .related span{font-size:14px;color:var(--muted)}
      .related p{margin:10px 0 0;font:500 26px/1.5 var(--serif)}
      .related:hover p{color:var(--accent)}
      .article-footer-label{margin:0 0 12px;color:var(--muted);font-size:13px}
      .source-list{display:flex;flex-wrap:wrap;gap:12px 24px;font-size:15px}
      .source-list a{color:var(--accent);text-decoration:underline;text-underline-offset:4px}
      .footer{width:min(calc(100% - 2 * var(--gutter)),1120px);margin:0 auto;padding:0 0 40px;color:var(--muted);font-size:14px}
      .footer-bottom{display:flex;justify-content:space-between;gap:24px;padding-top:22px;border-top:1px solid var(--line)}
      .footer-bottom a:hover{color:var(--accent)}
      @media(max-width:1020px){
        .reading-layout{grid-template-columns:minmax(0,1fr);gap:32px}
        .toc{position:static;grid-row:1;max-height:none}
        .toc summary{display:flex;align-items:center;justify-content:space-between;cursor:pointer;padding:16px 0;border-block:1px solid var(--line)}
        .toc summary img{display:block}
        .toc[open] summary img{transform:rotate(180deg)}
        .toc ol{border-top:0}
        .article-header,.article-body,.article-footer{max-width:720px}
      }
      @media(max-width:760px){
        :root{--gutter:24px}
        body{font-size:16px}
        .nav{height:72px}.identity{font-size:26px}.nav-links{gap:22px;font-size:14px}
        .article-shell{width:calc(100% - 2 * var(--gutter));padding:32px 0 64px}
        .back-link{margin-bottom:32px}
        .article-title{font-size:30px;line-height:1.5}
        .article-header{border-bottom:0;padding-bottom:0}
        .article-description{font-size:17px;line-height:1.7}
        .reading-layout{margin-top:28px;gap:28px}
        .article-body{font-size:18px;line-height:1.9}
        .article-body :global(h2){margin-top:56px;font-size:30px}
        .article-body :global(h3){margin-top:40px;font-size:24px}
        .article-body :global(blockquote){font-size:19px}
        .article-body :global(.article-figure){margin:34px 0}
        :global(.footnote-popover){left:16px!important;right:16px;width:auto;bottom:16px;top:auto!important;max-height:42svh;overflow:auto;padding:16px 18px;box-shadow:0 10px 28px #18181826}
        .footer{width:calc(100% - 2 * var(--gutter));padding-bottom:28px}
        .footer-bottom{align-items:flex-start;flex-direction:column;gap:12px}
      }
      @media(prefers-reduced-motion:reduce){html{scroll-behavior:auto}*,*::before,*::after{transition:none!important}}
      @media print{.nav,.toc,.back-link,.footer{display:none}.article-shell{width:100%;padding:0}.reading-layout{display:block}.article-body{max-width:none}.article-title{font-size:30px}}
      @view-transition{navigation:auto}
      ::view-transition-old(root){animation:reading-out .16s ease both}
      ::view-transition-new(root){animation:reading-in .24s var(--ease) both}
      @keyframes reading-out{to{opacity:0}}
      @keyframes reading-in{from{opacity:0}}
      @media(prefers-reduced-motion:reduce){::view-transition-old(root),::view-transition-new(root){animation:none}}
    </style>
  </head>
  <body>
    <a class="skip-link" href="#article-body">跳到正文</a>
    <nav class="nav" aria-label="主导航">
      <a class="identity" href="/" aria-label="Haoo 首页">Haoo<span>.</span></a>
      <div class="nav-links">
        <a href="/?state=writing#writing">文章</a>
        <a href="/?state=about#about">关于</a>
      </div>
    </nav>
    <main class="article-shell" id="article">
      <header class="article-header">
        <a class="back-link" href="/?state=writing#writing"><img src="/assets/arrow-down.svg" alt="" />返回文章目录</a>
        <div class="article-meta">
          <time datetime={pubDate.toISOString().slice(0, 10)}>{dateLabel}</time>
          <span>Haoo</span>
          <span>约 {readingMinutes} 分钟</span>
          <div class="article-tags" aria-label="文章标签">
            {tags.map((tag) => <span>#{tag}</span>)}
          </div>
        </div>
        <h1 class="article-title">{post.slug === 'ai-assisted-learning' ? (
          <>年度征文｜效率杂谈：告别<span class="keep">纸笔拓荒</span>，怎么用 AI 来辅助学习？</>
        ) : post.slug === 'kindle-paperwhite-3' ? (
          <>数码杂谈 | Kindle PaperWhite 3：为什么我推荐<span class="keep">高中生</span>使用电子书？</>
        ) : title}</h1>
        <p class="article-description">{description}</p>
      </header>
      <div class="reading-layout">
        <article class="article-body" id="article-body">
          <Content />
        </article>
        {chapters.length > 0 && (
          <details class="toc" open>
            <summary>本文目录<img src="/assets/arrow-down.svg" alt="" /></summary>
            <nav aria-label="本文目录">
              <ol>{chapters.map((chapter) => <li><a href={`#${chapter.slug}`}>{chapter.text}</a></li>)}</ol>
            </nav>
          </details>
        )}
      </div>
      {externalPublications.length > 0 && (
        <footer class="article-footer">
          <p class="article-footer-label">原始刊载</p>
          <div class="source-list">
            {externalPublications.map((publication) => (
              <a href={publication.url} target="_blank" rel="noopener noreferrer">
                {publication.platform === 'sspai' ? '少数派' : publication.platform === 'wechat' ? '微信公众号' : publication.platform}
              </a>
            ))}
          </div>
        </footer>
      )}
      {related && (
        <a class="related" href={`/posts/${related.slug}/`}>
          <span>继续阅读</span>
          <p>{related.data.title}</p>
        </a>
      )}
    </main>
    <footer class="footer">
      <div class="footer-bottom"><span>Haoo © 2026</span><a href="#article">回到顶部</a></div>
    </footer>
    <script is:inline>
      const toc = document.querySelector('.toc');
      if (toc && matchMedia('(max-width:1020px)').matches) toc.open = false;

      const article = document.querySelector('.article-body');
      const footnotes = article?.querySelector('.footnotes');
      let activeReference = null;
      let popover = null;

      const closeFootnote = (restoreFocus = false) => {
        if (!popover) return;
        const reference = activeReference;
        const closingPopover = popover;
        closingPopover.classList.remove('is-open');
        window.setTimeout(() => {
          closingPopover.remove();
          if (popover === closingPopover) popover = null;
        }, 180);
        activeReference = null;
        reference?.setAttribute('aria-expanded', 'false');
        if (restoreFocus) reference?.focus();
      };

      const positionFootnote = () => {
        if (!popover || !activeReference || matchMedia('(max-width:760px)').matches) return;
        const anchor = activeReference.getBoundingClientRect();
        const gap = 10;
        const width = popover.getBoundingClientRect().width;
        const height = popover.getBoundingClientRect().height;
        const left = Math.min(Math.max(16, anchor.left - 8), window.innerWidth - width - 16);
        const below = anchor.bottom + gap;
        const top = below + height <= window.innerHeight - 16
          ? below
          : Math.max(16, anchor.top - height - gap);
        popover.style.left = `${left}px`;
        popover.style.top = `${top}px`;
      };

      const openFootnote = (reference) => {
        const targetId = reference.getAttribute('href')?.slice(1);
        const source = targetId && footnotes?.querySelector(`#${CSS.escape(targetId)}`);
        if (!source) return;
        if (activeReference === reference) {
          closeFootnote();
          return;
        }
        closeFootnote();
        popover = document.createElement('aside');
        popover.className = 'footnote-popover';
        popover.setAttribute('role', 'dialog');
        popover.setAttribute('aria-label', `注释 ${reference.textContent?.trim() || ''}`);
        const content = source.cloneNode(true);
        content.removeAttribute('id');
        content.querySelector('.data-footnote-backref')?.remove();
        popover.innerHTML = '<button class="footnote-popover-close" type="button" aria-label="关闭注释">×</button><div class="footnote-popover-content"></div>';
        popover.querySelector('.footnote-popover-content')?.append(content);
        document.body.append(popover);
        activeReference = reference;
        reference.setAttribute('aria-expanded', 'true');
        reference.setAttribute('aria-controls', 'active-footnote-popover');
        popover.id = 'active-footnote-popover';
        popover.querySelector('.footnote-popover-close')?.addEventListener('click', () => closeFootnote(true));
        requestAnimationFrame(() => {
          popover?.classList.add('is-open');
          positionFootnote();
        });
      };

      article?.querySelectorAll('[data-footnote-ref]').forEach((reference) => {
        reference.setAttribute('aria-expanded', 'false');
        reference.addEventListener('click', (event) => {
          event.preventDefault();
          openFootnote(reference);
        });
      });
      document.addEventListener('click', (event) => {
        if (popover && !popover.contains(event.target) && !activeReference?.contains(event.target)) closeFootnote();
      });
      document.addEventListener('keydown', (event) => {
        if (event.key === 'Escape' && popover) closeFootnote(true);
      });
      window.addEventListener('resize', positionFootnote);
      window.addEventListener('scroll', positionFootnote, { passive: true });
    </script>
  </body>
</html>
