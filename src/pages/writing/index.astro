---
import { getCollection } from 'astro:content';
import Base from '../../layouts/Base.astro';
import Reader from '../../components/Reader.astro';
import { postMeta, readerItem } from '../../data/posts';
import '../../styles/parts.css';
import '../../styles/pages.css';

const posts = (await getCollection('posts', ({ data }) => !data.draft))
  .sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf());
const items = posts.map((post, i) => readerItem(post, i, posts.length));
// 按年份分组，新的在前
const years = [...new Set(posts.map((p) => p.data.pubDate.getFullYear()))];
---
<Base title="Writing" description="Essays, reviews and history research by Haoo, written in Chinese." active="/writing/">
  <header class="p-head">
    <p class="kick mono"><b>Writing</b><span>{posts.length} pieces · In Chinese, with English notes</span></p>
    <h1 class="p-h1" data-split>Written down.</h1>
    <p class="p-lede" data-rise>Essays on how I study and work, reviews of the gear I actually use, and soon, some history. The pieces are in Chinese; each one opens with a short English note.</p>
  </header>

  <div class="wl">
    <div class="wl-list">
      <ol class="wl-years" data-items={JSON.stringify(items)}>
        {years.map((y) => (
          <li class="year">
            <h2>{y}</h2>
            <ol>
              {posts.map((post, i) => post.data.pubDate.getFullYear() === y && (
                <li class:list={['entry', { on: i === 0 }]} data-p={String(i)}>
                  <span class="meta mono">{postMeta(post)}</span>
                  <a class="t" href={`/writing/${post.slug}/`}>{post.data.titleEn ?? post.data.title}</a>
                  <span class="zh" lang="zh-CN">{post.data.title}</span>
                  {post.data.dekEn && <p class="dek">{post.data.dekEn}</p>}
                </li>
              ))}
            </ol>
          </li>
        ))}
      </ol>
      <p class="wl-later">History research is on its way here.</p>
    </div>
    <div class="wl-reader">
      <Reader {...items[0]} class="reader-zoom" />
      <p class="wl-cap mono" aria-hidden="true">Fig. 05 The reader, on the desk</p>
    </div>
  </div>
</Base>

<script>
  import { $ } from '../../scripts/core';
  import { rises } from '../../scripts/motion';
  import { bindReader } from '../../scripts/parts';

  bindReader($('.wl-years')!, $('[data-screen]')!);
  rises();
</script>
