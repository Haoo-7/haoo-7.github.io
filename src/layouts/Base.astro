---
import Bar from '../components/Bar.astro';
import Footer from '../components/Footer.astro';
import Loader from '../components/Loader.astro';
import { siteConfig } from '../data/site';
import '../styles/base.css';

interface Props {
  title?: string;
  description?: string;
  active?: string;
  hello?: boolean;
  progress?: boolean;
  reader?: boolean;
  image?: string;
  type?: 'website' | 'article';
}
const { title, description = siteConfig.description, active, hello = true, progress = false, reader = false, image = '/images/refresh/tech.jpg', type = 'website' } = Astro.props;
const fullTitle = title ? `${title} — Haoo` : 'Haoo — Life, Tech & History';
const canonical = new URL(Astro.url.pathname, Astro.site);
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <meta property="og:type" content={type} />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={new URL(image, Astro.site)} />
    <meta property="og:url" content={canonical} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png" />
    <link rel="alternate" type="application/rss+xml" title="Haoo" href="/rss.xml" />
    <link rel="preload" href="/fonts/refresh/literata.woff2" as="font" type="font/woff2" crossorigin />
    <link rel="preload" href="/fonts/refresh/plex-mono-400.woff2" as="font" type="font/woff2" crossorigin />
    {reader && (
      <script is:inline>
        // 读者上次选的字体和字号，在首帧之前就套上，不先用默认字排一遍再跳
        try {
          var r = JSON.parse(localStorage.getItem('haoo:reading') || '{}');
          if (r.face === 'sans') document.documentElement.dataset.face = 'sans';
          if (r.size >= 0 && r.size <= 4 && r.size !== 1) document.documentElement.dataset.size = String(r.size);
        } catch (e) {}
      </script>
    )}
    <slot name="head" />
  </head>
  <body id="top">
    <Loader />
    <a class="skip mono" href="#main">Skip to content</a>
    <Bar active={active} progress={progress} reader={reader} />
    <main id="main" class="page">
      <slot />
    </main>
    <Footer hello={hello} tail={Astro.slots.has('end')}><slot name="end" /></Footer>
    <script>
      import '../scripts/core';
    </script>
  </body>
</html>
