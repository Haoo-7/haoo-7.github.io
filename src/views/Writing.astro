---
import { getCollection } from 'astro:content';
import Base from '../layouts/Base.astro';
import Reader from '../components/Reader.astro';
import { postMeta, readerItem } from '../data/posts';
import { pathFor, type Lang } from '../i18n/lang';
import { ui } from '../i18n/ui';
import '../styles/parts.css';
import '../styles/pages.css';

interface Props { lang: Lang }
const { lang } = Astro.props;
const t = ui[lang];
const posts = (await getCollection('posts', ({ data }) => !data.draft))
  .sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf());
const items = posts.map((post, i) => readerItem(post, i, posts.length, lang));
// 按年份分组，新的在前
const years = [...new Set(posts.map((p) => p.data.pubDate.getFullYear()))];
---
<Base lang={lang} title="Writing" description={t.meta.writing} active="/writing/">
  <header class="p-head">
    <p class="kick mono" lang="en"><b>Writing</b><span>{posts.length} pieces{lang === 'en' && ' · In Chinese, with English notes'}</span></p>
    <h1 class="p-h1" data-split lang="en">Written <em>down.</em></h1>
    <p class="p-lede" data-rise>{t.writing.intro}</p>
  </header>

  <div class="wl">
    <div class="wl-list">
      <ol class="wl-years" data-items={JSON.stringify(items)}>
        {years.map((y) => (
          <li class="year">
            <h2 lang="en">{y}</h2>
            <ol>
              {posts.map((post, i) => post.data.pubDate.getFullYear() === y && (
                <li class:list={['entry', { on: i === 0 }]} data-p={String(i)}>
                  <span class="meta mono" lang="en">{postMeta(post, false, lang)}</span>
                  <a class="t" href={pathFor(`/writing/${post.slug}/`, lang)}>{lang === 'zh' ? post.data.title : post.data.titleEn ?? post.data.title}</a>
                  {lang === 'en' && <span class="zh" lang="zh-CN">{post.data.title}</span>}
                  {(lang === 'zh' || post.data.dekEn) && <p class="dek">{lang === 'zh' ? post.data.description : post.data.dekEn}</p>}
                </li>
              ))}
            </ol>
          </li>
        ))}
      </ol>
    </div>
    <div class="wl-reader">
      <Reader {...items[0]} lang={lang} class="reader-zoom" />
      <p class="wl-cap mono" aria-hidden="true" lang="en">Fig. <b>05</b> The reader, on the desk</p>
    </div>
  </div>
</Base>

<script>
  import { $ } from '../scripts/core';
  import { rises } from '../scripts/motion';
  import { bindReader } from '../scripts/parts';

  bindReader($('.wl-years')!, $('[data-screen]')!);
  rises();
</script>
