---
// 页脚右端：首屏那只猫的尾巴从页面后面一路穿下来，从页脚上沿那条线后面垂出来；往下拉，拉过头就回到顶部
import { htmlLang, type Lang } from '../i18n/lang';
import { ui } from '../i18n/ui';
interface Props { lang?: Lang }
const { lang = 'en' } = Astro.props;
---
<div class="tailtip" lang={htmlLang(lang)}>
  <button class="tail-btn" type="button" data-tailtip aria-label={ui[lang].a11y.tail}>
    <svg viewBox="0 0 120 240" width="120" height="240" aria-hidden="true">
      <path class="tail-line" d="M86 -14 L86 -14" />
      <path class="tail-grab" d="M86 -14 L86 -14" />
    </svg>
  </button>
</div>
