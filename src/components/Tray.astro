---
// 切割垫上的分格盒就是作品目录：前几格按顺序放作品，其余空着
import { projects } from '../data/projects';
interface Props {
  class?: string;
}
const { class: cls = '' } = Astro.props;
const cells = [
  { n: '01', l: 132, t: 215, w: 122, h: 137 },
  { n: '02', l: 266, t: 215, w: 123, h: 137 },
  { n: '03', l: 397, t: 215, w: 126, h: 137 },
  { n: '04', l: 132, t: 359, w: 122, h: 135 },
  { n: '05', l: 266, t: 359, w: 123, h: 135 },
  { n: '06', l: 397, t: 359, w: 126, h: 135 },
].map((cell, i) => ({ ...cell, c: i < projects.length ? String(i) : 'later' }));
---
<div class:list={['crop tray-crop', cls]} aria-hidden="true">
  <div class="art tray" style="--ar: 1100 / 733">
    <img class="img" src="/images/refresh/bench.jpg" width="1536" height="1024" alt="" loading="lazy" decoding="async" />
    {cells.map((cell) => (
      <div class:list={['cell pin', { empty: cell.c === 'later' }]} data-cell={cell.c} style={`--W:1100;--H:733;--l:${cell.l};--t:${cell.t};--w:${cell.w};--h:${cell.h}`}><b>{cell.n}</b></div>
    ))}
  </div>
</div>
